# Alpaca API — create free account at alpaca.markets
# Paper trading is always free; live requires a funded brokerage account
ALPACA_API_KEY=your_key_here
ALPACA_SECRET_KEY=your_secret_here
ALPACA_PAPER=true          # true = paper | false = live

# Database
DB_PASSWORD=changeme

# LLM (Ollama — self-hosted, no API fees)
LLM_API_URL=http://ollama:11434/v1/chat/completions
LLM_MODEL=llama3.1:8b

# Trading controls
TRADE_MODE=suggest         # suggest | paper | live
                           # Start with suggest, verify signals, then paper, then live

# Leveraged ETF pairs + their underlyings (underlyings ingested for directional context)
SYMBOLS=TQQQ,SQQQ,UPRO,SPXU,SOXL,SOXS,QQQ,SPY,SOXX

# Risk management
MAX_POSITION_USD=500       # max notional per trade (ATR-based sizing applied on top)
MAX_DAILY_LOSS_USD=200     # hard stop: halt + close all if daily loss exceeds this
MAX_OPEN_POSITIONS=5       # max concurrent open positions

# Regulatory note:
# SEC eliminated PDT $25k minimum equity requirement effective June 4, 2026.
# Brokerages have until Oct 20, 2027 to comply. Verify your broker's current
# intraday margin policy before switching TRADE_MODE=live.

# Coinbase Advanced Trade API (primary crypto execution venue)
# Key name format: organizations/<org-id>/apiKeys/<key-id>
COINBASE_API_KEY_NAME=organizations/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx/apiKeys/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Paste your EC private key below — replace actual newlines with \n
COINBASE_API_PRIVATE_KEY=-----BEGIN EC PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END EC PRIVATE KEY-----

# Ethereum on-chain wallet (optional — for DEX/on-chain custody, separate from Coinbase)
# Generate: python -c "from eth_account import Account; import secrets; print(Account.from_key('0x'+secrets.token_hex(32)).key.hex())"
WALLET_PRIVATE_KEY=             # 0x-prefixed 64-hex-char private key
WALLET_NETWORK=mainnet          # mainnet | sepolia (testnet)
